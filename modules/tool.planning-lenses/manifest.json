{
  "id": "tool.planning-lenses",
  "name": "Planning Lenses",
  "version": "0.1.0",
  "description": "SWE Planning Mode procedure with configurable lens set. Default lenses: architecture, implementation, test-strategy.",
  "contributes": {
    "promptFragments": [
      { "target": "tpm", "contentPath": "planning-tpm.md" },
      { "target": "swe", "contentPath": "planning-swe.md" }
    ],
    "settings": {
      "lenses": {
        "type": "string",
        "label": "Lens set",
        "description": "Comma-separated list of planning lenses.",
        "default": "architecture, implementation, test-strategy"
      }
    }
  }
}
