{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghola.local/schemas/module-manifest.json",
  "title": "Ghola Module Manifest",
  "type": "object",
  "required": ["id", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Unique module id."
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "entry": { "type": "string" },
    "proactive": { "type": "boolean" },
    "category": {
      "type": "string",
      "enum": ["safety", "workflow", "orchestration", "integration", "knowledge", "session-mode", "utility"],
      "description": "Functional domain group used for UI filtering and display."
    },
    "kind": {
      "type": "string",
      "enum": ["capability", "convention", "workflow"],
      "description": "Whether the module adds a positive ability ('capability') or purely constrains agent behavior ('convention')."
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Module IDs this module depends on. Empty array or omitted means no hard dependencies."
    },
    "mutuallyExclusiveWith": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Module IDs that cannot be enabled alongside this module. The panel uses this to auto-disable conflicts."
    },
    "trigger": {
      "type": "string",
      "enum": ["session-start", "user-request", "phrase-detection", "always-applied", "event"],
      "description": "How the module activates beyond the binary proactive flag."
    },
    "tier": {
      "type": "string",
      "enum": ["essential", "recommended", "optional"],
      "description": "Onboarding priority — drives the setup walkthrough's recommendation order."
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promptFragments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "contentPath"],
            "additionalProperties": false,
            "properties": {
              "target": {
                "anyOf": [
                  { "enum": ["tpm", "swe", "qa", "all"] },
                  { "type": "string", "minLength": 1 }
                ],
                "description": "Agent target. Canonical values: tpm, swe, qa, all. Modules may also declare custom agent ids via contributes.agents."
              },
              "contentPath": { "type": "string", "minLength": 1 }
            }
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "definitionPath"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "definitionPath": { "type": "string", "minLength": 1 }
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "label"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "enum", "path", "keyValue"]
              },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "default": {},
              "required": { "type": "boolean" },
              "options": {
                "type": "array",
                "items": { "type": "string" }
              },
              "keywordsPath": { "type": "string", "minLength": 1 },
              "multiSelect": { "type": "boolean" },
              "multiline": { "type": "boolean" },
              "valueSource": {
                "type": "string",
                "enum": ["linqpad-connections"]
              },
              "keyLabel": { "type": "string" },
              "valueLabel": { "type": "string" },
              "valueReadonly": { "type": "boolean" },
              "valueOptions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "optionalValue": { "type": "boolean" },
              "optionalEnabled": { "type": "boolean" },
              "optionalDescription": { "type": "boolean" },
              "descriptionLabel": { "type": "string" },
              "fullWidth": { "type": "boolean" },
              "enabledStyle": {
                "type": "string",
                "enum": ["toggle", "checkbox"]
              },
              "keywordsLabel": { "type": "string" },
              "selectColumnLabel": { "type": "string" }
            }
          }
        },
        "settingsPanelSections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "placement"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "placement": { "type": "string" },
              "contentPath": { "type": "string" }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type", "description"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["script", "mcp"] },
              "description": { "type": "string" },
              "command": { "type": "string" },
              "mcpServer": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
