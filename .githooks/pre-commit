#!/usr/bin/env bash
#
# .githooks/pre-commit
# Ghola version sync: VERSION is the single source of truth. Before each commit,
# rewrite package.json's top-level "version" to match the VERSION file and stage
# it, so the VSIX (vsce reads package.json) and the vX.Y.Z tag (post-commit hook
# reads VERSION) always agree. No-op when they already match.
#
# It also runs the parity gates over this repo's hand-maintained duplicates (see
# the parity block below) - the ONE thing in this hook that can refuse a commit.
#
# Skip a single run with:   GHOLA_SKIP_HOOK=1 git commit ...
#
# The version-sync half never blocks a commit: every failure path exits 0 and
# leaves package.json as-is.
set -uo pipefail

[ -n "${GHOLA_SKIP_HOOK:-}" ] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# --- hand-maintained-duplicate parity gates ---------------------------------
# A few rule sets in this repo are implemented more than once ON PURPOSE, because
# the copies have to run where they cannot share code (pure bash with no
# subprocess, a `node` script outside the esbuild bundle, an embedded `python3`
# heredoc). Each duplicate has a checker script whose own header explains why its
# copies cannot be centralized. Both sets registered below have already drifted
# silently, with keep-in-sync comments as the only enforcement. Comments do not
# fail a commit; this block does.
#
# THE REGISTRY - one `|`-delimited record per checker:
#
#   <checker path>|<what it guards, used in the messages>|<trigger paths, space separated>
#
# A checker's OWN path is ALWAYS a trigger and is deliberately not spelled out in
# its record: a checker's case table and extraction anchors are as load-bearing as
# the implementations it compares, so a commit that edits a checker must re-run
# it. Adding a gate means adding one record here; nothing else in this hook
# changes.
PARITY_CHECKS=(
  "scripts/ghola-path-parity.mjs|the three host-path translation copies|scripts/ghola-boot-probe.sh src/session/host-path.ts scripts/ghola.mjs"
  "scripts/ghola-statusline-parity.mjs|the three statusline state-key copies|src/session/statusline-state.ts scripts/ghola-statusline.mjs scripts/ghola-statusline.sh"
)
#
# Runs FIRST, before the version sync below, so a refusal happens before this hook
# has rewritten or staged anything. Each checker runs ONLY when the staged set
# touches one of ITS OWN trigger paths, so an ordinary docs or module commit pays
# nothing for either of them, and staging a statusline file never runs the
# host-path checker (or the reverse).
#
# EVERY triggered checker runs, even after one has already failed, and every
# failure is reported before the single refusal at the end. Two gates that both
# broke get fixed in one pass instead of the second surfacing on the next attempt.
#
# Blocks on exit 1 (a genuine divergence) and ONLY on that. No node, no esbuild, a
# checker missing from disk, an implementation the checker could not reach (exit
# 2), or any unexpected status all print and let the commit through: a gate that
# blocks because tooling is absent gets switched off by its owner within a week,
# and then it guards nothing at all.
#
# The staged list is CAPTURED once and then matched in pure bash - no pipe into
# grep. Two reasons: `set -o pipefail` plus an early-exiting consumer turns the
# producer's SIGPIPE into a spurious pipeline failure (CLAUDE.md rule 7), and
# string equality needs no external binary, so the gates still evaluate correctly
# in the stripped-down PATH a GUI commit can hand us. The match is exact
# whole-path equality, so a path that merely CONTAINS one of these names does not
# trigger a check.
#
# `--no-renames` matters: with git's default rename detection a MOVE of one of
# these files reports only the destination path, so moving an implementation away
# - exactly the change most likely to break a checker's anchors - would slip past
# the gate. Without detection the move is a delete + an add, and the old path is
# in the list.
staged="$(git diff --cached --name-only --no-renames 2>/dev/null)"

# 0 when any staged path is EXACTLY one of the arguments. Reads the captured
# $staged via a here-string, so there is no pipeline and no subshell.
parity_is_staged() {
  local f t
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    for t in "$@"; do
      [ "$f" = "$t" ] && return 0
    done
  done <<<"$staged"
  return 1
}

parity_blocked=""
for parity_record in "${PARITY_CHECKS[@]}"; do
  IFS='|' read -r pscript psubject ptriggers <<<"$parity_record"
  # `read -a` rather than unquoted expansion: it splits on whitespace WITHOUT
  # pathname expansion, so a trigger path could never be glob-expanded. The
  # checker is appended here rather than passed as a separate argument, so the
  # array is never empty - `"${arr[@]}"` on an empty array is an unbound-variable
  # error under `set -u` on older bash. Trigger paths therefore may not contain a
  # space; nothing in this repo's tracked tree does.
  read -r -a ptrigger_paths <<<"$ptriggers $pscript"
  parity_is_staged "${ptrigger_paths[@]}" || continue

  if ! command -v node >/dev/null 2>&1; then
    echo "[ghola-hook] pre-commit: node not on PATH - $pscript SKIPPED (commit allowed)."
    continue
  fi
  if [ ! -f "$pscript" ]; then
    # A triggered checker that is not on disk (fresh clone, stash, partial
    # checkout) is an absent tool, not a divergence. Refusing the commit because
    # the guard is missing would be worse than the drift it guards.
    echo "[ghola-hook] pre-commit: $pscript missing - parity check SKIPPED (commit allowed)."
    continue
  fi
  if [ ! -d node_modules/esbuild ]; then
    # Both checkers type-strip a .ts implementation with the in-tree esbuild. On a
    # fresh clone or mid-`npm install` they simply cannot run - again an absent
    # tool, not a divergence.
    echo "[ghola-hook] pre-commit: esbuild not installed - $pscript SKIPPED (commit allowed)."
    continue
  fi

  # `timeout` when it exists: a wedged subprocess inside a pre-commit hook is the
  # one failure mode with no obvious way out. Its 124 lands in the fail-open arm
  # below, like any other unexpected status.
  if command -v timeout >/dev/null 2>&1; then
    parity_out="$(timeout 30 node "$pscript" 2>&1)"
    prc=$?
  else
    parity_out="$(node "$pscript" 2>&1)"
    prc=$?
  fi
  case "$prc" in
    0)
      :   # parity OK - silent, which is every normal run (~0.1s per checker)
      ;;
    1)
      echo "$parity_out"
      echo "[ghola-hook] pre-commit: PARITY FAILED - $pscript"
      echo "[ghola-hook]   reports that $psubject DISAGREE (report above)."
      echo "[ghola-hook]   Reproduce with:  node $pscript"
      echo "[ghola-hook]   Reconcile the copies - or, if a difference is intentional, record it in"
      echo "[ghola-hook]   every keep-in-sync comment AND teach the checker to expect it."
      parity_blocked="$parity_blocked $pscript"
      ;;
    2)
      # Exit 2 = an implementation could not be REACHED. Ambiguous by
      # construction: equally a rename that broke the guard and a refactor
      # mid-flight (and, for the statusline checker, a host with no `python3`).
      # Deliberately NOT fatal - blocking would make the hook the enemy of the
      # refactor it exists to protect (the commit that repairs a checker's anchors
      # is itself a commit that touches these files). It is loud instead: the full
      # report prints, the next commit touching these files re-runs it, and a real
      # divergence still exits 1 once the anchors line up again.
      echo "$parity_out"
      echo "[ghola-hook] pre-commit: PARITY UNVERIFIED - $pscript"
      echo "[ghola-hook]   could not reach one of the implementations it compares (renamed,"
      echo "[ghola-hook]   reindented, or an interpreter it needs is missing), so parity of"
      echo "[ghola-hook]   $psubject is NOT verified for this commit."
      echo "[ghola-hook]   The commit is ALLOWED. Fix the anchors or the source, then re-run:"
      echo "[ghola-hook]   node $pscript"
      ;;
    *)
      echo "[ghola-hook] pre-commit: $pscript exited $prc (could not run) - SKIPPED, commit allowed."
      ;;
  esac
done

if [ -n "$parity_blocked" ]; then
  echo "[ghola-hook] pre-commit: BLOCKED - parity gate failure in:$parity_blocked"
  echo "[ghola-hook]   This hook rewrote and staged NOTHING; fix the divergence(s) reported above"
  echo "[ghola-hook]   and commit again."
  echo "[ghola-hook]   Commit anyway (last resort):  GHOLA_SKIP_HOOK=1 git commit ..."
  exit 1
fi

[ -f VERSION ] || exit 0
[ -f package.json ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

ver="$(tr -d ' \t\r\n' < VERSION 2>/dev/null)"
[ -z "$ver" ] && exit 0

cur="$(node -e 'try{process.stdout.write(String(require("./package.json").version||""))}catch(e){}' 2>/dev/null)"
lockcur=""
[ -f package-lock.json ] && lockcur="$(node -e 'try{process.stdout.write(String(require("./package-lock.json").version||""))}catch(e){}' 2>/dev/null)"
# Skip the WHOLE hook only when BOTH package.json AND package-lock.json already
# match $ver. Gating on package.json alone let the lockfile drift a version
# behind, since VERSION and package.json are bumped together (in sync) before
# each commit — the early exit fired and the lock sync block never ran.
if [ "$cur" = "$ver" ] && { [ ! -f package-lock.json ] || [ "$lockcur" = "$ver" ]; }; then
  exit 0
fi

# Rewrite ONLY the first (top-level) "version": "..." string; preserve all other
# formatting. Node exit 2 == already in sync / no top-level version match (clean
# no-op); handled like the lock block below so a lock-only bump stays silent.
node -e '
  const fs = require("fs");
  const ver = process.argv[1];
  const p = fs.readFileSync("package.json", "utf8");
  const out = p.replace(/("version"\s*:\s*")[^"]*(")/, (m, a, b) => a + ver + b);
  if (out === p) process.exit(2);   // already in sync or no top-level version — do not write
  fs.writeFileSync("package.json", out);
' "$ver" 2>/dev/null
rc=$?
if [ "$rc" -eq 0 ]; then
  git add package.json 2>/dev/null || true
  echo "[ghola-hook] pre-commit: synced package.json version -> $ver"
elif [ "$rc" -eq 2 ]; then
  :   # already in sync — silent no-op
else
  echo "[ghola-hook] pre-commit: could not sync package.json version (left unchanged)."
fi

# Also sync package-lock.json so the lockfile never drifts a version behind
# package.json. Rewrite ONLY the first two "version": "..." strings (the root
# version and packages[""].version); dependency versions come after and are
# left untouched. Node exit 2 == already in sync (clean no-op).
if [ -f package-lock.json ]; then
  node -e '
    const fs = require("fs");
    const ver = process.argv[1];
    const p = fs.readFileSync("package-lock.json", "utf8");
    let n = 0;
    const out = p.replace(/("version"\s*:\s*")[^"]*(")/g, (m, a, b) => (n++ < 2) ? a + ver + b : m);
    if (out === p) process.exit(2);   // nothing changed (already in sync or no match)
    fs.writeFileSync("package-lock.json", out);
  ' "$ver" 2>/dev/null
  rc=$?
  if [ "$rc" -eq 0 ]; then
    git add package-lock.json 2>/dev/null || true
    echo "[ghola-hook] pre-commit: synced package-lock.json version -> $ver"
  elif [ "$rc" -eq 2 ]; then
    :   # already in sync — silent no-op
  else
    echo "[ghola-hook] pre-commit: could not sync package-lock.json version (left unchanged)."
  fi
fi

exit 0
