{
  "name": "nomeda",
  "displayName": "Nomeda",
  "description": "Modular multi-agent dev team for VS Code.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "nomeda.openSettings",
        "title": "Nomeda: Open Settings"
      },
      {
        "command": "nomeda.openSession",
        "title": "Nomeda: Open Session"
      },
      {
        "command": "nomeda.reloadModules",
        "title": "Nomeda: Reload Modules"
      }
    ],
    "configuration": {
      "title": "Nomeda",
      "properties": {
        "nomeda.modulesDir": {
          "type": "string",
          "default": "modules",
          "description": "Directory (relative to workspace root) containing Nomeda modules."
        },
        "nomeda.sessionCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command phrase sent to the Nomeda Session terminal after launch (e.g. 'claude', 'claude --resume'). Leave empty to skip."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "concurrently --kill-others-on-fail --names build,extension --prefix-colors yellow,cyan \"npm:watch\" \"echo Press F5 in VS Code to launch the Extension Development Host\"",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}
