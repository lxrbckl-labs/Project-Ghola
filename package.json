{
  "name": "nomeda",
  "displayName": "Nomeda",
  "description": "Modular multi-agent dev team for VS Code.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nomeda.openSettings",
        "title": "Nomeda: Open Settings"
      },
      {
        "command": "nomeda.openSession",
        "title": "Nomeda: Open Session"
      },
      {
        "command": "nomeda.reloadModules",
        "title": "Nomeda: Reload Modules"
      }
    ],
    "configuration": {
      "title": "Nomeda",
      "properties": {
        "nomeda.modulesDir": {
          "type": "string",
          "default": "modules",
          "description": "Directory (relative to workspace root) containing Nomeda modules."
        },
        "nomeda.sessionCommand": {
          "type": "string",
          "default": "initiate",
          "description": "Command phrase sent to the Nomeda Session terminal after launch (e.g. 'initiate', 'initiate --resume'). Leave empty to skip."
        },
        "nomeda.swe.performanceCores": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "SWE performance cores (primary workers for the critical-path task)."
        },
        "nomeda.swe.efficiencyCores": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "SWE efficiency cores (lower-priority side workers)."
        },
        "nomeda.qa.count": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum concurrent QA subagents."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "concurrently --kill-others-on-fail --names build,extension --prefix-colors yellow,cyan \"npm:watch\" \"echo Press F5 in VS Code to launch the Extension Development Host\"",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}
